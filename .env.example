BOT_TOKEN=your_bot_token_here
TRAVELPAYOUTS_API_KEY=your_travelpayouts_api_key_here

# PostgreSQL container settings. Use a private password; URL-encode special
# characters in DATABASE_URL. For Compose's generated URL, use a URL-safe password.
POSTGRES_DB=flight_tracker
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me

# Used when running Python locally. Compose overrides these URLs for the bot.
DATABASE_URL=postgresql+asyncpg://postgres:change_me@localhost:5432/flight_tracker
REDIS_URL=redis://localhost:6379/0

PRICE_CHECK_INTERVAL=3600
SQL_ECHO=false
